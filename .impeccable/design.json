  "narrative": {
    "northStar": "The Interview Workbench",
    "overview": "本地优先的面试学习工具台。界面是操作型（Operate）的：高压、低注意力场景下，信息层级服务于「听题 → 转写 → 出答案」主链。世界由三层构成：语义化多主题（6 套主题共享同一套 --c-* 令牌）、玻璃拟态悬浮层、结果先行的并行可读平面。主题化机制是核心不变量：新组件必须只用语义令牌。",
    "keyCharacteristics": [
      "语义化多主题（6 套）",
      "玻璃浮层 + 实色平面两级深度",
      "角色化转录（面试官/你自己）",
      "低音量实时动效（脉冲/电平条）",
      "结果先行的双栏工作区"
    ],
    "rules": [
      {
        "name": "The Semantic Accent Rule",
        "body": "蓝=行动、绿=成功/录制、琥珀=注意/建议、红=错误/删除；同义分层用透明度，不新增色相。",
        "section": "colors"
      },
      {
        "name": "The Muted Floor Rule",
        "body": "次要文本对比度不低于 text-muted（浅色 ~4.6:1）。",
        "section": "colors"
      },
      {
        "name": "The Two-Face Rule",
        "body": "只用两族字体：Plus Jakarta Sans + Noto Sans SC 与 JetBrains Mono。",
        "section": "typography"
      },
      {
        "name": "The Two-Pane Interview Rule",
        "body": "实时辅助主区固定 左转录 | 右答案 双栏，可选 288px 备忘常驻栏。",
        "section": "layout"
      },
      {
        "name": "The Glass Float Rule",
        "body": "悬浮层用玻璃面浮起，实体面板用实色平面，两级深度不混淆。",
        "section": "elevation"
      },
      {
        "name": "The Focus Ring Rule",
        "body": "键盘焦点统一 2px 语义色外环 + offset 2px。",
        "section": "elevation"
      }
    ],
    "dos": [
      "只用语义令牌，新组件先映射现有令牌",
      "一个界面一个主按钮，蓝色唯一",
      "纯图标按钮必带 aria-label",
      "数字/耗时用等宽 + tabular-nums"
    ],
    "donts": [
      "硬编码色值或新增状态色相",
      "在实体面板上加投影冒充浮层",
      "用 text-muted 更浅的对比度承载信息",
      "引入第三族字体或新圆角体系",
      "让弹层遮挡触发点"
    ]
  }

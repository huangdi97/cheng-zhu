{
  "policy_version": "v2.0-R1-stable-promotion-3",
  "purpose": "Product-evidence graduation gate for Chengzhu Conversation v2. Thresholds are unchanged from policy v2, but metric populations are now bound to immutable runtime provenance so manual/dogfood events and forced silence cannot inflate Stable evidence. This is an acceptance gate, not a scientific universal benchmark and not a PMF claim.",
  "profiles_required": {
    "PROJECT_SYNC": {
      "distinct_users": 5,
      "sessions": 20,
      "cross_session_spaces": 3
    },
    "DESIGN_REVIEW": {
      "distinct_users": 5,
      "sessions": 20,
      "cross_session_spaces": 3
    }
  },
  "metrics": {
    "opportunity_precision": {
      "direction": "gte",
      "threshold": 0.8,
      "min_n": 30,
      "allowed_label_sources": [
        "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT",
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "interruption_regret": {
      "direction": "lte",
      "threshold": 0.15,
      "min_n": 30,
      "allowed_label_sources": [
        "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT"
      ]
    },
    "source_attribution_accuracy": {
      "direction": "gte",
      "threshold": 0.95,
      "min_n": 30,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "recall_precision": {
      "direction": "gte",
      "threshold": 0.9,
      "min_n": 20,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "useful_silence_rate": {
      "direction": "gte",
      "threshold": 0.8,
      "min_n": 30,
      "allowed_label_sources": [
        "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT",
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "direct_question_precision": {
      "direction": "gte",
      "threshold": 0.9,
      "min_n": 20,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "direct_question_recall": {
      "direction": "gte",
      "threshold": 0.85,
      "min_n": 20,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "decision_commitment_state_precision": {
      "direction": "gte",
      "threshold": 0.9,
      "min_n": 30,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "continue_writeback_accuracy": {
      "direction": "gte",
      "threshold": 0.95,
      "min_n": 20,
      "allowed_label_sources": [
        "INDEPENDENT_HUMAN_REVIEW"
      ]
    },
    "mean_cognitive_load_delta": {
      "direction": "lte",
      "threshold": -0.25,
      "min_n": 15,
      "allowed_label_sources": [
        "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT"
      ]
    },
    "space_reuse_intent_rate": {
      "direction": "gte",
      "threshold": 0.7,
      "min_n": 15,
      "allowed_label_sources": [
        "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT"
      ]
    }
  },
  "required_attestations": [
    "AUTHORIZED_REAL_USE",
    "NO_SYNTHETIC_ROWS_IN_HUMAN_EVAL",
    "RAW_LABELS_KEPT_LOCAL",
    "NO_CRITICAL_PRIVACY_INCIDENT",
    "NO_KNOWN_DATA_LOSS"
  ],
  "claims": {
    "on_pass": "PRODUCT_EVIDENCE_READY_FOR_STABLE_RELEASE_REVIEW",
    "not_granted": [
      "V2_STABLE_RELEASE",
      "PMF_PROVEN",
      "REAL_USER_VALUE_UNIVERSALLY_PROVEN"
    ]
  },
  "change_control": "Thresholds are unchanged from policy v2. Policy v3 is a pre-pilot population/provenance correction made before real pilot results are available: do not broaden populations, mix manual-lab events, count forced silence, or lower a threshold merely to make a failing pilot pass.",
  "label_source_policy": {
    "LOCAL_IN_PRODUCT_EXPLICIT_SELF_REPORT": "Explicit post-session labels entered in Chengzhu on the local device. Valid for user-perception/outcome measures only where a metric explicitly allows it; not verified identity proof.",
    "INDEPENDENT_HUMAN_REVIEW": "Explicit human review performed independently from the in-product self-report surface under the human-label protocol.",
    "UNSPECIFIED": "Never accepted for stable-promotion metric thresholds."
  },
  "metric_population_contract": {
    "live_guidance_metrics": {
      "applies_to": [
        "opportunity_precision",
        "interruption_regret",
        "source_attribution_accuracy",
        "recall_precision"
      ],
      "required_origin_kind": "TRANSCRIPT_AUTO",
      "required_transcript_segment_id": true,
      "excluded": [
        "MANUAL_GUIDANCE_LAB",
        "PRE_V12_UNCLASSIFIED_GUIDANCE"
      ]
    },
    "useful_silence_rate": {
      "required_origin_kind": "TRANSCRIPT_AUTO",
      "required_decision_class": "ARBITER",
      "excluded_decision_classes": [
        "MODE_FORCED",
        "PROFILE_FORCED",
        "PROVENANCE_FORCED"
      ],
      "interpretation": "Measures whether the automatic Guidance Arbiter correctly chose not to interrupt; policy/profile/provenance hard blocks are audit evidence, not Useful Silence samples."
    },
    "decision_commitment_state_precision": {
      "predicted_types": [
        "Decision",
        "Commitment",
        "Task"
      ],
      "denominator": "Rows whose immutable predicted_type is Decision, Commitment, or Task and that have independent actual_type + actual_state labels.",
      "correctness": "predicted_type == actual_type AND predicted_state == actual_state",
      "excluded_predicted_types": [
        "Deadline",
        "Risk",
        "Assumption",
        "OpenQuestion",
        "Proposal",
        "Objection",
        "Metric",
        "Status"
      ]
    },
    "direct_question": {
      "source": "v11 capture-time conversation_transcript_segment.analysis.direct_question",
      "historical_reclassification": "FORBIDDEN"
    }
  }
}
